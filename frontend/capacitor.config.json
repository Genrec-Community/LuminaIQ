{
  "appId": "fun.luminaiq.app",
  "appName": "Lumina IQ",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#FDF6F0"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2500,
      "launchAutoHide": true,
      "backgroundColor": "#FDF6F0",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "LocalNotifications": {
      "iconColor": "#C8A288"
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false
      },
      "logLevel": 1
    }
  }
}
