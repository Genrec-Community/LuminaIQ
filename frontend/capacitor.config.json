{
  "appId": "fun.luminaiq.app",
  "appName": "LuminaIQ",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#FDF6F0"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2500,
      "launchAutoHide": true,
      "backgroundColor": "#FDF6F0",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "LocalNotifications": {
      "iconColor": "#C8A288"
    }
  }
}
