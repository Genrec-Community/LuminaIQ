# ==============================================================================
# LuminaIQ Frontend Environment Configuration (.env) - Vercel Deployment
# ==============================================================================
# Provide these values in your Vercel Project Settings -> Environment Variables

# 1. Backend API Endpoint
# Set this to the URL of your deployed Azure Backend
VITE_MAIN_API_URL=https://your-azure-backend-app.azurewebsites.net/api/v1

# 2. Supabase Configuration (Authentication & Client APIs)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
