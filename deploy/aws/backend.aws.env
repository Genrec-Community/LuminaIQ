# AWS overrides on top of the old Azure BACKEND_ENV (deploy.sh merges them; later keys win).
# Secrets (AI keys) are NOT here: they live in SSM Parameter Store under /luminaiq/env/<NAME>.
# __REMOVE__ drops a key.
AZURE_CV_ENDPOINT=__REMOVE__
AZURE_CV_KEY=__REMOVE__
QDRANT_URL=__REMOVE__
QDRANT_API_KEY=__REMOVE__
BACKEND_CORS_ORIGINS=https://luminaiq.fun,https://www.luminaiq.fun,https://test.luminaiq.fun,https://luminaiq-test.vercel.app,http://localhost:5173,capacitor://localhost,https://localhost,http://localhost
WORKER_INLINE=true
WORKER_CONCURRENCY=2
MAIN_API_WEBHOOK_URL=http://localhost:8000/api/v1/webhook/document-ready
# AI on AWS Bedrock's OpenAI-compatible endpoint ("mantle"): it answers on the free plan, where the
# bedrock-runtime quotas are 0. Key: BEDROCK_MANTLE_KEY, installed on the server (AWS ops install-secret).
LLM_BASE_URL=https://bedrock-mantle.ap-southeast-2.api.aws/v1
LLM_DEEP_BASE_URL=https://bedrock-mantle.ap-southeast-2.api.aws/v1
LLM_API_KEY=@BEDROCK_MANTLE_KEY
LLM_DEEP_API_KEY=@BEDROCK_MANTLE_KEY
LLM_MODEL=openai.gpt-oss-120b
LLM_LIGHT_MODEL=openai.gpt-oss-120b
LLM_DEEP_MODEL=openai.gpt-oss-120b
LLM_REASONING_EFFORT=low
# No embedding model answers on the free plan: books are searched by keyword only.
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=none
EMBEDDING_DIMENSION=1024
EMBEDDING_BASE_URL=__REMOVE__
EMBEDDING_API_KEY=__REMOVE__
SMALL_LLM_BASE_URL=https://bedrock-mantle.ap-southeast-2.api.aws/v1
SMALL_LLM_API_KEY=@BEDROCK_MANTLE_KEY
# Per-feature models (all on Bedrock mantle, paid from the credits). gpt-oss-120b is the fallback
# when a chosen model fails. GPT-5.x is not offered on mantle in this region (404).
SMALL_LLM_MODEL=qwen.qwen3-235b-a22b-2507
BIG_LLM_BASE_URL=https://bedrock-mantle.ap-southeast-2.api.aws/v1
BIG_LLM_API_KEY=@BEDROCK_MANTLE_KEY
BIG_LLM_MODEL=deepseek.v3.2
LLM_TASK_MODELS=memory=qwen.qwen3-next-80b-a3b-instruct,rewrite=qwen.qwen3-next-80b-a3b-instruct,lab=qwen.qwen3-coder-next,big:lab=qwen.qwen3-coder-next,vision=qwen.qwen3-vl-235b-a22b-instruct
FALLBACK_LLM_MODEL=openai.gpt-oss-120b
