# AWS overrides on top of the old Azure BACKEND_ENV (deploy.sh merges them; later keys win).
# Secrets (AI keys) are NOT here: they live in SSM Parameter Store under /luminaiq/env/<NAME>.
# __REMOVE__ drops a key.
AZURE_CV_ENDPOINT=__REMOVE__
AZURE_CV_KEY=__REMOVE__
QDRANT_URL=__REMOVE__
QDRANT_API_KEY=__REMOVE__
BACKEND_CORS_ORIGINS=https://luminaiq.fun,https://www.luminaiq.fun,https://test.luminaiq.fun,https://luminaiq-test.vercel.app,http://localhost:5173,capacitor://localhost,https://localhost,http://localhost
WORKER_INLINE=true
WORKER_CONCURRENCY=2
MAIN_API_WEBHOOK_URL=http://localhost:8000/api/v1/webhook/document-ready
# AI on AWS Bedrock, paid from the AWS credit (owner, 2026-11-22). BEDROCK_API_KEY is in SSM
# (/luminaiq/env/BEDROCK_API_KEY, a Bedrock API key of IAM user luminaiq-bedrock). Embeddings use the
# server's own AWS role (Titan v2, 1024-d; the chunk tables were switched from 768 with AWS ops set-embedding-dim).
LLM_BASE_URL=https://bedrock-runtime.ap-southeast-2.amazonaws.com/openai/v1
LLM_DEEP_BASE_URL=https://bedrock-runtime.ap-southeast-2.amazonaws.com/openai/v1
LLM_API_KEY=@BEDROCK_API_KEY
LLM_DEEP_API_KEY=@BEDROCK_API_KEY
LLM_MODEL=openai.gpt-oss-120b-1:0
LLM_LIGHT_MODEL=openai.gpt-oss-120b-1:0
LLM_DEEP_MODEL=openai.gpt-oss-120b-1:0
LLM_REASONING_EFFORT=low
EMBEDDING_PROVIDER=bedrock
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSION=1024
EMBEDDING_SEND_DIMENSIONS=false
EMBEDDING_BASE_URL=__REMOVE__
EMBEDDING_API_KEY=__REMOVE__
