# Lumina IQ backend settings. Copy to .env (repo root, read by docker compose and
# by `uv run run.py`) or backend/.env (takes priority). Never commit the real file.
# Every key is optional unless marked REQUIRED; defaults live in backend/config/settings.py.

# ── App ──
# development | test | production
ENVIRONMENT=development
PORT=8000
# REQUIRED in production (JWT signing)
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=11520
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Supabase: sign-in and file storage only ── REQUIRED
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# ── App database: every table, vectors, jobs, caches ── REQUIRED
# docker compose sets this to its own container; set it to RDS in production.
DATABASE_URL=postgresql://lumina:lumina@localhost:5432/lumina
# Connections per process, and whether to apply db/schema on startup
DB_POOL_SIZE=10
RUN_MIGRATIONS=true
# Threads for database/storage calls per process
DB_THREADS=32

# ── Background jobs ──
# true = each web process also runs jobs (dev, single server). In production set
# false and run `uv run worker.py` processes (docker compose does this for you).
WORKER_INLINE=true
WORKER_CONCURRENCY=2
JOB_POLL_SECONDS=1.0
JOB_STALE_SECONDS=300

# ── Per-user rate limits ──
RATE_LIMITS_ENABLED=true
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_GENERATE_PER_MIN=10
RATE_LIMIT_UPLOAD_PER_HOUR=30
# Optional Redis. Start it with: docker compose --profile redis up
# e.g. redis://localhost:6379/0
REDIS_URL=

# ── Chat models: any OpenAI-compatible API ── REQUIRED (small)
# OpenAI, Groq, Together, OpenRouter, vLLM, Ollama, Azure (https://<resource>.openai.azure.com/openai/v1/) ...
# Small: most work, and every request from free users
SMALL_LLM_BASE_URL=
SMALL_LLM_API_KEY=
SMALL_LLM_MODEL=
SMALL_LLM_REASONING_EFFORT=
# Big: Deep answers, Visual Lab builds, photo questions for paid plans (empty = small model;
# base URL and key default to the small model's)
BIG_LLM_BASE_URL=
BIG_LLM_API_KEY=
BIG_LLM_MODEL=
BIG_LLM_REASONING_EFFORT=
LLM_TIMEOUT_SECONDS=120

# ── Embeddings: any OpenAI-compatible /embeddings API ── REQUIRED
# Base URL and key default to the small chat model's.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Must match the model (max 2000). Fixed when the chunks table is first created.
EMBEDDING_DIMENSION=1536
EMBEDDING_SEND_DIMENSIONS=false
EMBEDDING_BATCH_SIZE=50

# ── Optional reranker (Cohere / Jina / Voyage style /rerank) ── on only when the key is set
RERANK_API_KEY=
RERANK_BASE_URL=https://api.cohere.com/v2
RERANK_MODEL=rerank-v3.5

# ── Retrieval ──
# Below this similarity the book "doesn't cover" a question (answers go beyond the book, labelled)
RAG_MIN_SIMILARITY=0.30
RAG_TOP_PASSAGES=6
CHUNK_TOKENS=500
CHUNK_OVERLAP_TOKENS=75

# ── Cost (Phase 4) ──
# Prices in USD per 1M tokens, for the admin "AI costs" dashboard (0 = unknown; calls are still
# counted). Cached input defaults to the input price when left at -1.
SMALL_LLM_PRICE_INPUT=0
SMALL_LLM_PRICE_OUTPUT=0
SMALL_LLM_PRICE_CACHED_INPUT=-1
BIG_LLM_PRICE_INPUT=0
BIG_LLM_PRICE_OUTPUT=0
BIG_LLM_PRICE_CACHED_INPUT=-1
EMBEDDING_PRICE_INPUT=0
RERANK_PRICE_PER_CALL=0
# Token budgets for one chat prompt (rough tokens = characters / 4)
CONTEXT_BUDGET_EXCERPTS=6000
CONTEXT_BUDGET_HISTORY=2500
CONTEXT_BUDGET_PROFILE=1200
# What the tutor knows about the student: learner model, memory notes and the chat summary
CONTEXT_BUDGET_MEMORY=900
# Cached answers to the first question of a chat on shared-library / class books
ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_TTL_DAYS=30
SEMANTIC_CACHE_THRESHOLD=0.95
# Shared quiz/flashcard pools and notes/mindmaps for shared-library and class books
SHARED_CONTENT_ENABLED=true
# Fill a class book's quiz and flashcard pools as soon as it's published (costs AI up front)
PREGENERATE_SHARED=false
# Optional AI-call tracing in Langfuse (on when both keys are set)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── OCR (unchanged) ──
OCR_LOCAL_ENABLED=true
OCR_DPI=200
OCR_MAX_PAGES=600
AZURE_CV_ENDPOINT=
AZURE_CV_KEY=
GOOGLE_VISION_CREDENTIALS=
GOOGLE_VISION_MONTHLY_PAGES=900
INDRA_OCR_URL=
INDRA_OCR_TOKEN=

# ── Webhooks ── REQUIRED in production (change from defaults)
WEBHOOK_SECRET=change-me
MAIN_API_WEBHOOK_SECRET=change-me
MAIN_API_WEBHOOK_URL=http://localhost:8000/api/v1/webhook/document-ready

# ── Payments (Razorpay) ── empty = payments disabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_SCHOLAR_MONTHLY=
RAZORPAY_PLAN_SCHOLAR_YEARLY=
RAZORPAY_PLAN_TOPPER_MONTHLY=
RAZORPAY_PLAN_TOPPER_YEARLY=
PLAN_LIMITS_ENABLED=true
PLAN_TIMEZONE=Asia/Kolkata

# ── Schools and admin ──
PLATFORM_ADMIN_EMAILS=
STUDENT_LOGIN_DOMAIN=luminaiq.fun
INSTITUTION_REQUIRE_APPROVAL=true
INSTITUTION_TRIAL_DAYS=14
INSTITUTION_GSTIN=
SCHOOL_EXPIRY_SWEEP=true
SELF_CHECK_ON_STARTUP=true

# ── Processing and concurrency ──
MAX_FILE_SIZE=104857600
MAX_CONCURRENT_GENERAL=40
MAX_CONCURRENT_DOCUMENT_UPLOADS=2
MAX_GLOBAL_DB_OPERATIONS=10
MAX_GLOBAL_EMBEDDINGS=5
MAX_CONCURRENT_LLM=3
GUNICORN_WORKERS=3
# GUNICORN=1                       # run several workers (production)
# WEB_CONCURRENCY=3

# ── Book store ──
BOOK_STORE_PAGE_SIZE=20
BOOK_STORE_MAX_DESCRIPTION=2000
BOOK_IMPORT_TEXTS_BUCKET=texts
