# ==============================================================================
# LuminaIQ Master Deployment Environment Configuration
# ==============================================================================
# This file contains EVERY environment variable needed to deploy LuminaIQ from 
# scratch across all supported platforms (Vercel, Render, Azure, AWS, etc.).
# DO NOT commit actual secrets to version control.
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# [1] FRONTEND CONFIGURATION (Vercel / Azure Static Web Apps / AWS Amplify)
# ──────────────────────────────────────────────────────────────────────────────
# The URL where your backend API is hosted. 
# Must include /api/v1 (e.g., https://your-backend.onrender.com/api/v1)
VITE_MAIN_API_URL=http://localhost:8000/api/v1

# Supabase details for the frontend to authenticate users directly
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ──────────────────────────────────────────────────────────────────────────────
# [2] BACKEND CORE SERVER CONFIGURATION (Render / Azure Container Apps / AWS ECS)
# ──────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
PORT=8000
# Used for session security and internal cryptographic operations
SECRET_KEY=your-super-secret-key-change-in-production

# Comma-separated list of allowed frontend domains (No trailing slashes!)
# Example: http://localhost:5173,https://your-app.vercel.app,https://luminaiq.com
BACKEND_CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# File upload configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ──────────────────────────────────────────────────────────────────────────────
# [3] SUPABASE CONFIGURATION (Database & Storage for Backend)
# ──────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# ──────────────────────────────────────────────────────────────────────────────
# [4] UNIFIED AI MODEL CONFIGURATION (RECOMMENDED)
# ──────────────────────────────────────────────────────────────────────────────
# Set this once! It will automatically authenticate Azure OpenAI OR OpenRouter/OpenAI.
MODEL_API_KEY=your-model-api-key-here

# ──────────────────────────────────────────────────────────────────────────────
# [5] AZURE OPENAI CONFIGURATION (Microsoft Founders Hub / Azure Credits)
# ──────────────────────────────────────────────────────────────────────────────
# If AZURE_OPENAI_ENDPOINT is set, the system uses Azure.
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ──────────────────────────────────────────────────────────────────────────────
# [6] STANDARD OPENAI / OPENROUTER / LLMs (Fallback)
# ──────────────────────────────────────────────────────────────────────────────
# Used if Azure OpenAI is NOT configured.
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=z-ai/glm-4.5-air:free

EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional Together AI Configuration
TOGETHER_API_KEY=your-together-api-key

# ──────────────────────────────────────────────────────────────────────────────
# [7] VECTOR DATABASE (Qdrant)
# ──────────────────────────────────────────────────────────────────────────────
# Local: http://localhost:6333 | Cloud: https://your-cluster.aws.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key-if-cloud

# ──────────────────────────────────────────────────────────────────────────────
# [8] CLOUD OCR (Azure Computer Vision - Optional but Recommended)
# ──────────────────────────────────────────────────────────────────────────────
AZURE_CV_ENDPOINT=https://<region>.api.cognitive.microsoft.com/
AZURE_CV_KEY=your-azure-cv-key

# ==============================================================================
# DEPLOYMENT CHEATSHEET & PLATFORM SPECIFICS
# ==============================================================================
# VERCEL (Frontend): 
#   Needs: VITE_MAIN_API_URL, VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY
# 
# RENDER (Backend): 
#   Needs: ENVIRONMENT, BACKEND_CORS_ORIGINS, SUPABASE_*, MODEL_API_KEY
# 
# AZURE CONTAINER APPS (Backend): 
#   Needs: AZURE_OPENAI_*, SUPABASE_*, BACKEND_CORS_ORIGINS, PORT=8000
# 
# AWS APP RUNNER (Backend):
#   Needs: SUPABASE_*, MODEL_API_KEY, PORT=8000, BACKEND_CORS_ORIGINS
# ==============================================================================
