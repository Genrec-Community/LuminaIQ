# ==============================================================================
# LuminaIQ Backend Environment Configuration (.env)
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# 1. SINGLE UNIFIED MODEL API KEY (RECOMMENDED WAY TO SET API KEY)
# ──────────────────────────────────────────────────────────────────────────────
# Set MODEL_API_KEY once — used automatically by both LLM and Embedding services
# if explicit keys below are not provided. Works with Azure OpenAI or OpenRouter/OpenAI.
MODEL_API_KEY=your-model-api-key-here

# ──────────────────────────────────────────────────────────────────────────────
# Option A: Azure OpenAI Configuration (Microsoft Founders Hub / Azure credits)
# ──────────────────────────────────────────────────────────────────────────────
# If using Azure OpenAI, endpoint and deployment names are required:
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ──────────────────────────────────────────────────────────────────────────────
# Option B: Standard / OpenRouter / OpenAI-Compatible Configuration (Fallback)
# ──────────────────────────────────────────────────────────────────────────────
# If AZURE_OPENAI_ENDPOINT is not set, the app falls back to these settings:
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=z-ai/glm-4.5-air:free
# Better models for paying users: plan=model pairs (Azure: deployment names).
# Plans left out use LLM_MODEL. Example:
# LLM_TIER_MODELS=free=gpt-4.1-nano,scholar=gpt-4.1-mini,topper=gpt-4.1,institution=gpt-4.1-mini
LLM_TIER_MODELS=

EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ──────────────────────────────────────────────────────────────────────────────
# 2. Supabase Configuration (Database & Storage)
# ──────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# ──────────────────────────────────────────────────────────────────────────────
# 3. Vector Database & Cloud OCR
# ──────────────────────────────────────────────────────────────────────────────
# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Azure Computer Vision — OCR for scanned PDFs & image uploads
AZURE_CV_ENDPOINT=https://<region>.api.cognitive.microsoft.com/
AZURE_CV_KEY=

# Optional: Together AI
TOGETHER_API_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# 4. Application Server Configuration
# ──────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
PORT=8000
SECRET_KEY=your-super-secret-key-change-in-production
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://lumina-iq-livid.vercel.app,https://luminaiq.fun
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# ──────────────────────────────────────────────────────────────────────────────
# 5. Payments (Razorpay) and schools
# ──────────────────────────────────────────────────────────────────────────────
# Test mode: use the rzp_test_ keys from Razorpay Dashboard → Settings → API Keys.
# Switch to rzp_live_ keys for real payments. Empty = payments switched off.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → URL https://<backend>/api/v1/billing/webhook, events:
# payment.captured, order.paid, payment.failed, subscription.* ; paste the secret here
RAZORPAY_WEBHOOK_SECRET=
# Optional: Razorpay Subscription plan IDs make Scholar / Topper renew automatically
# (scripts/create_razorpay_plans.py). Leave empty to sell one-time months / years.
# RAZORPAY_PLAN_SCHOLAR_MONTHLY= ... _SCHOLAR_YEARLY, _TOPPER_MONTHLY, _TOPPER_YEARLY
# Enforce the Free / Scholar / Topper limits in services/plans.py (default true)
PLAN_LIMITS_ENABLED=true

# Student sign-in IDs look like studentname-07@<STUDENT_LOGIN_DOMAIN> (not mailboxes)
STUDENT_LOGIN_DOMAIN=luminaiq.fun
# New schools need approval in the platform console (/platform) before they work
INSTITUTION_REQUIRE_APPROVAL=true
# Free trial days given at approval (0 = pay first)
INSTITUTION_TRIAL_DAYS=14
# Our GSTIN. Leave empty until registered: school prices then have no GST line
INSTITUTION_GSTIN=
# Who can open the platform console (besides user_roles owner/admin)
PLATFORM_ADMIN_EMAILS=you@example.com
